FROM node:24-bookworm-slim
ARG CLAUDE_VERSION=2.1.308
RUN npm install --global "@anthropic-ai/claude-code@${CLAUDE_VERSION}" && npm cache clean --force
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 10001 expert
USER expert
WORKDIR /workspace
ENTRYPOINT ["claude"]
CMD ["--version"]
