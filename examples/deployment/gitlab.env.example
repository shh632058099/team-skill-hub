# Runtime image published from the GitHub repository.
SKILL_HUB_IMAGE=ghcr.io/your-org/team-skill-hub:latest
SKILL_HUB_PORT=8080
SKILL_HUB_CONFIG_FILE=./config/repositories.gitlab.yaml

# MCP caller authentication. Replace examples with random values.
AUTH_MODE=api-key
SKILL_HUB_API_KEYS_JSON={"replace-dev-key":{"id":"developer","roles":["developer","internal"],"tenantId":"rd"},"replace-customer-key":{"id":"customer","roles":["customer"],"tenantId":"customer"}}

# Operational endpoints and GitLab webhook authentication.
ADMIN_API_KEY=replace-with-random-admin-key
GITLAB_WEBHOOK_TOKEN=replace-with-random-webhook-token

# SSH is recommended. These paths are read by Docker Compose on the host.
GITLAB_SSH_KEY_FILE=./secrets/gitlab_skillhub_ed25519
GITLAB_KNOWN_HOSTS_FILE=./secrets/gitlab_known_hosts

# Only needed when using repositories.gitlab-https.example.yaml.
GITLAB_USERNAME=oauth2
GITLAB_TOKEN=
