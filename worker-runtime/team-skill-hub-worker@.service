[Unit]
Description=Team Skill Hub Expert Worker (%i)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=expert-worker
Group=expert-worker
Environment=EXPERT_WORKER_INSTANCE=%i
EnvironmentFile=/etc/team-skill-hub-worker/workers/%i.env
WorkingDirectory=/opt/team-skill-hub-worker/current
ExecStartPre=/usr/bin/node /opt/team-skill-hub-worker/current/check-worker-config.js
ExecStart=/usr/bin/node /opt/team-skill-hub-worker/current/src/cli/expert-worker.js
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/team-skill-hub-worker/%i /run/docker.sock

[Install]
WantedBy=multi-user.target
