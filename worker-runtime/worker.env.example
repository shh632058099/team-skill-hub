# Template only. Create a runnable instance with:
#   sudo worker-control.sh init <instance>
# which copies this file to /etc/team-skill-hub-worker/workers/<instance>.env.
# EXPERT_WORKER_INSTANCE is injected by worker-control.sh or systemd and should not be set here.
# Instance-local defaults derived from EXPERT_WORKER_INSTANCE:
#   /var/lib/team-skill-hub-worker/<instance>/worker-credential
#   /var/lib/team-skill-hub-worker/<instance>/source
#   /var/lib/team-skill-hub-worker/<instance>/repositories
# Never commit a real credential or API key.

EXPERT_HUB_ADDRESS=hub.internal.example:7443
EXPERT_WORKER_ID=replace-with-unique-worker-id

# Preferred first-boot flow: Hub bootstrap token; remove it after the credential is saved.
EXPERT_WORKER_BOOTSTRAP_TOKEN=replace-with-deployment-bootstrap-token
# Optional override:
# EXPERT_WORKER_CREDENTIAL_FILE=/srv/team-skill-hub-worker/worker-credential
# Legacy/manual fallback: set EXPERT_WORKER_CREDENTIAL instead of the bootstrap token.
# EXPERT_WORKER_CREDENTIAL=ewc_replace-with-admin-issued-credential

EXPERT_CAPABILITY=ota
EXPERT_ID=ota

# Optional instance-local path overrides. Omit to use the derived defaults above.
# EXPERT_SOURCE_PATH=/srv/team-skill-hub-worker/source
# EXPERT_REPOSITORY_ROOT=/srv/team-skill-hub-worker/repositories
# Managed paths under /var/lib/team-skill-hub-worker must stay inside this
# instance by default. Migration-only escape hatch for reviewed legacy paths:
# EXPERT_ALLOW_MANAGED_PATH_OVERRIDES=true
# Remove the escape hatch after moving legacy state into the instance directory.

# Claude Code is the default. Existing Codex workers must explicitly set backend=codex.
EXPERT_EXECUTOR_BACKEND=claude
# V2 Deployment compatibility: advertise only Profiles this Worker can execute.
EXPERT_RUNTIME_PROFILES=linux-ota

# MCP credentials are file-based. Do NOT put the Skill Hub MCP API Key directly in this env file.
# 1. In Admin, create a dedicated API Key with ONLY role worker-mcp-readonly.
# 2. Save the real key in this instance's private key directory, for example:
#      /etc/team-skill-hub-worker/instances/claude-01/keys/skillhub-readonly
#    with owner expert-worker:expert-worker and mode 0600.
# 3. Map Deployment.mcp.credentialRef to that file. Replace <instance> with the
#    real instance name from "worker-control.sh init <instance>".
# Example for instance claude-01:
# EXPERT_MCP_CREDENTIAL_FILES_JSON='{"skillhub-readonly":"/etc/team-skill-hub-worker/instances/claude-01/keys/skillhub-readonly"}'
# If Deployment.mcp.credentialRef is "skillhub-readonly", the Worker reads the
# API Key from the mapped file at task execution time.
# MCP URL is resolved from Deployment.mcp.urlOverride first, then this Worker default.
# The URL must resolve from inside the task container, NOT to container localhost.
# EXPERT_MCP_URL=http://hub.internal.example:8080/mcp
EXPERT_DOCKER_IMAGE=team-skill-hub-expert-claude:0.1.0
EXPERT_CLAUDE_MODEL=sonnet
EXPERT_MODEL_ENV_NAMES=ANTHROPIC_API_KEY,HTTPS_PROXY,NO_PROXY
# Provide ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN securely on the Worker host.
# To manually use Codex instead, set all of these:
# EXPERT_EXECUTOR_BACKEND=codex
# EXPERT_DOCKER_IMAGE=team-skill-hub-expert-worker:0.1.0
# EXPERT_MODEL_ENV_NAMES=TEAM_SKILL_HUB_API_KEY,HTTPS_PROXY,NO_PROXY
# EXPERT_MODEL_CREDENTIAL_REFS_JSON='{"bst-router":"TEAM_SKILL_HUB_API_KEY"}'
EXPERT_DOCKER_NETWORK=bridge
EXPERT_DOCKER_SECCOMP_PROFILE=default
# Optional private Git credentials; use instance-local key files.
# EXPERT_GIT_CREDENTIALS_JSON='{"repo-readonly":"/etc/team-skill-hub-worker/instances/<instance>/keys/repo-readonly"}'
# Optional proxy reachable from the Worker host/container.
# HTTPS_PROXY=http://proxy.internal:7890
# NO_PROXY=127.0.0.1,localhost
EXPERT_HEARTBEAT_MS=10000
EXPERT_POLL_MS=3000
EXPERT_TASK_TIMEOUT_MS=120000
