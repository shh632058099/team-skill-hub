  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "npm run build && npm test",
    "benchmark": "node scripts/benchmark.mjs",
