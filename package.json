    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "jszip": "^3.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
