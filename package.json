{
  "name": "team-skill-hub",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:client-integration": "tsx src/cli/build-client-integration.ts",
    "client-integration:version-check": "tsx src/cli/client-integration-version-check.ts",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.js package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" eslint.config.js package.json tsconfig.json .prettierrc.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check": "npm run format:check && npm run lint && npm run build && npm test",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:capacity": "tsx src/cli/benchmark-capacity.ts",
    "validate:repo": "tsx src/cli/validate-repository.ts",
    "evaluate:repo": "tsx src/cli/evaluate-repository.ts",
    "ci:evaluate": "tsx src/cli/evaluate-repository.ts",
    "backup:data": "tsx src/cli/backup-data.ts",
    "restore:data": "tsx src/cli/restore-data.ts",
    "release:check": "tsx src/cli/release-check.ts",
    "plugin:build": "tsx src/cli/build-codex-plugin.ts",
    "sandbox:acceptance": "tsx src/cli/gitlab-sandbox-acceptance.ts",
    "release:registry-acceptance": "tsx src/cli/release-registry-acceptance.ts",
    "migrate:observability": "tsx src/cli/migrate-observability.ts",
    "export:observability": "tsx src/cli/export-observability.ts",
    "benchmark:sqlite-observability": "tsx src/cli/benchmark-sqlite-observability.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/fastify": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "fastify": "^5.6.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.7.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
